# Vercel runtime values. Set these in Vercel, never in browser VITE_* values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
APP_MODE=production
SIMULATION_ENABLED=false
# Used only by npm run init:cloud (minimum 12-character password).
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_NAME=FlowDepot Owner
BOOTSTRAP_OWNER_PASSWORD=replace-with-a-strong-owner-password
